# Secrets — never bake into images
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Git / IDE
.git
.gitignore
.cursor
.vscode
.idea

# Python junk
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
*.egg-info
# Root-only build artifacts (do NOT ignore frontend/dist)
/dist
/build

# Frontend deps — keep frontend/dist for the combined studio image
frontend/node_modules

# Runtime data (mounted at CapRover)
projects

# Local noise
.DS_Store
