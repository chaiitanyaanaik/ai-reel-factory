# Copy this file to .env and fill in your key(s).

# --- Google (required for script/plan generation) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here

# --- Pexels (recommended, free stock video for B-roll) ---
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key_here

# --- Optional overrides ---

# Gemini text model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Veo video model used as fallback when Pexels has no match (default: veo-3.0-generate-001)
# VEO_MODEL=veo-3.0-fast-generate-001

# Disable Veo fallback entirely (Pexels only, no AI generation cost)
# BROLL_USE_VEO=0

# Generate all B-roll with Veo (skip Pexels). Use for script-aligned AI clips.
# BROLL_VEO_ONLY=1

# Log every Veo prompt to console + projects/<proj>/broll/veo_prompts.log
# VEO_LOG_PROMPTS=1

# --- Captions + light effects (render) ---
# Burn-in captions into final video (recommended)
# BURN_IN_CAPTIONS=1
# Caption vertical margin from bottom safe zone (pixels)
# CAPTION_MARGIN_V=80
# Caption font size for burn-in
# CAPTION_FONT_SIZE=54

# Short white flash at B-roll start times
# FLASH_ON_BROLL=1
# FLASH_DURATION_FLASH=0.06

# --- Output quality tuning (render) ---
# Audio cleanup
# AUDIO_DENOISE=afftdn
# AUDIO_COMPRESS=1
# AUDIO_LOUDNORM=0
# AUDIO_HIGHPASS_HZ=100
# AUDIO_LOWPASS_HZ=12000
# SPEAKER_VOLUME_DB=2.5

# Higher quality RNNoise denoise (only if your FFmpeg supports arnndn and you have a model file)
# AUDIO_DENOISE=arnndn
# ARNNDN_MODEL_PATH=C:\path\to\rnnoise-model.rnnn

# Video clarity
# SCALE_FLAGS=lanczos
# VIDEO_DENOISE=0
# VIDEO_SHARPEN=1
