# =============================================================================
# TEMPLATE ONLY — copy to `.env` for local development (gitignored).
# Production: set the SAME variable names on the host / secret manager.
# Do NOT commit `.env`, `.env.production`, or real keys.
# =============================================================================

# development | production  (production → host env wins; API rejects AUTH_MODE=dev)
ENVIRONMENT=development

# --- Google (required for plan/script/cover; Veo for B-roll) ---
GOOGLE_API_KEY=your_api_key_here

# --- B-roll: Google Veo only (low-cost Lite) ---
BROLL_VEO_ONLY=1
BROLL_USE_VEO=1
VEO_MODEL=veo-3.1-lite-generate-preview
VEO_DURATION_SECONDS=4
VEO_RESOLUTION=720p
# Leave unset/0 on AI Studio (Developer API). generate_audio is Enterprise-only;
# even generate_audio=false is rejected by the Developer API.
VEO_GENERATE_AUDIO=0
VEO_MAX_CLIPS=5
# Parallel Veo clip generation (default 3)
VEO_PARALLELISM=3
# Log full Veo prompts to projects/<id>/broll/veo_prompts.log
# VEO_LOG_PROMPTS=1
# Optional: Gemini rewrite of suggestion+spoken line before Veo (extra API call)
# VEO_EXPAND_PROMPT=0

# --- Pexels (optional; skipped when BROLL_VEO_ONLY=1) ---
# PEXELS_API_KEY=your_pexels_key_here

# Audio enhance preset applied in the enhance stage
AUDIO_PRESET=social
AUDIO_DENOISE=afftdn
AUDIO_COMPRESS=1
AUDIO_LOUDNORM=1
AUDIO_HIGHPASS_HZ=80
AUDIO_LOWPASS_HZ=10000
SPEAKER_VOLUME_DB=2.5

# Offline tests only: allow placeholder script/plan on LLM failure
# ALLOW_PLACEHOLDERS=0

# --- Editor agent pacing guardrails ---
# EDITOR_MAX_BROLL_COUNT=5
# EDITOR_MIN_BROLL_SECONDS=2
# EDITOR_MAX_BROLL_SECONDS=4
# EDITOR_MIN_BROLL_GAP=3.5
# EDITOR_MIN_HOOK_AROLL=3
# EDITOR_MIN_END_AROLL=2.5
# EDITOR_MIN_AROLL_SHARE=0.55

# --- Optional model overrides ---
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3-flash-preview
# Upgrade: VEO_MODEL=veo-3.1-fast-generate-preview
# MAX_BROLL_SECONDS=4
# BURN_IN_CAPTIONS=1

# Frontend (Vite) CORS — local origins. Production: set real frontend URL(s) on the host.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth: Clerk (recommended) ---
# Backend verifies Clerk session JWTs.
# Frontend publishable key: frontend/.env (see frontend/.env.example) — not here.
AUTH_MODE=clerk
AUTH_REQUIRED=1
# Required for media tokens (≥32 chars). Generate: openssl rand -hex 32
AUTH_SECRET=
# Clerk Dashboard → Configure → API Keys → Frontend API URL (no trailing slash)
# Use the *development* Clerk instance locally; production issuer on the host.
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
# Optional overrides (defaults: JWKS at {CLERK_ISSUER}/.well-known/jwks.json)
# CLERK_JWKS_URL=
# CLERK_AUDIENCE=

# Legacy local email login (no Clerk): AUTH_MODE=dev and leave CLERK_ISSUER unset
# Production host should set:
#   ENVIRONMENT=production
#   COOKIE_SECURE=1
#   CORS_ORIGINS=https://your.frontend.domain
# AUTH_TOKEN_TTL_SECONDS=604800
# MEDIA_TOKEN_TTL_SECONDS=3600
# LEGACY_PUBLIC_PROJECTS=0

# --- Per-user daily caps (protect shared Google keys; 0 = unlimited) ---
# RATE_LIMIT_PROJECTS_PER_DAY=20
# RATE_LIMIT_JOBS_PER_DAY=30
# RATE_LIMIT_BROLL_EDITS_PER_DAY=40

# --- Langfuse (cost + latency traces; optional) ---
# Tracks broll_generate / broll_regenerate / reel_rerender with user_id + project_id.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# US: https://us.cloud.langfuse.com  |  EU: https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_HOST is also accepted (alias of BASE_URL)
