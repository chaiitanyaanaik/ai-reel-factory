# Copy this file to .env and fill in your key(s).

# --- Google (required for plan/script/cover; Veo only if enabled) ---
GOOGLE_API_KEY=your_api_key_here

# --- Pexels (recommended, free stock video for B-roll) ---
PEXELS_API_KEY=your_pexels_key_here

# --- B-roll: Google Veo only (low-cost Lite) ---
BROLL_VEO_ONLY=1
BROLL_USE_VEO=1
VEO_MODEL=veo-3.1-lite-generate-preview
VEO_DURATION_SECONDS=4
VEO_RESOLUTION=720p
# Leave unset/0 on AI Studio (Developer API). generate_audio is Enterprise-only;
# even generate_audio=false is rejected by the Developer API.
VEO_GENERATE_AUDIO=0
VEO_MAX_CLIPS=5
# Log full Veo prompts to projects/<id>/broll/veo_prompts.log
# VEO_LOG_PROMPTS=1
# Optional: Gemini rewrite of suggestion+spoken line before Veo (extra API call)
# VEO_EXPAND_PROMPT=0

# Audio enhance preset applied in the enhance stage
AUDIO_PRESET=social
AUDIO_DENOISE=afftdn
AUDIO_COMPRESS=1
AUDIO_LOUDNORM=1
AUDIO_HIGHPASS_HZ=80
AUDIO_LOWPASS_HZ=10000
SPEAKER_VOLUME_DB=2.5

# Offline tests only: allow placeholder script/plan on LLM failure
# ALLOW_PLACEHOLDERS=0

# --- Editor agent pacing guardrails ---
# EDITOR_MAX_BROLL_COUNT=5
# EDITOR_MIN_BROLL_SECONDS=2
# EDITOR_MAX_BROLL_SECONDS=4
# EDITOR_MIN_BROLL_GAP=3.5
# EDITOR_MIN_HOOK_AROLL=3
# EDITOR_MIN_END_AROLL=2.5
# EDITOR_MIN_AROLL_SHARE=0.55

# --- Optional model overrides ---
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3-flash-preview
# Upgrade: VEO_MODEL=veo-3.1-fast-generate-preview
# MAX_BROLL_SECONDS=4
# BURN_IN_CAPTIONS=1

# Frontend (Vite) CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Multi-user auth (Phase 1) ---
# AUTH_MODE=dev | clerk | off
# Local without Clerk: AUTH_MODE=dev. With Clerk UI: AUTH_MODE=clerk + CLERK_ISSUER.
# Publishable key goes in frontend/.env as VITE_CLERK_PUBLISHABLE_KEY (not here).
AUTH_MODE=dev
AUTH_REQUIRED=1
# Generate a long random secret (≥32 chars). Required for media tokens when AUTH_MODE=clerk.
AUTH_SECRET=reelkut-dev-secret-change-me-32b
# ENVIRONMENT=production
# COOKIE_SECURE=1
# AUTH_TOKEN_TTL_SECONDS=604800
# MEDIA_TOKEN_TTL_SECONDS=3600
# Show pre-auth projects with no owner_id to signed-in users
# LEGACY_PUBLIC_PROJECTS=0
# Clerk (AUTH_MODE=clerk) — Frontend API URL from Clerk Dashboard:
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=
# CLERK_AUDIENCE=

# --- Per-user daily caps (protect shared Google/Pexels keys; 0 = unlimited) ---
# Do NOT hop/rotate free API keys for quota — use billing + these limits instead.
# RATE_LIMIT_PROJECTS_PER_DAY=20
# RATE_LIMIT_JOBS_PER_DAY=30
# RATE_LIMIT_BROLL_EDITS_PER_DAY=40

# --- Langfuse (cost + latency traces; optional) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
