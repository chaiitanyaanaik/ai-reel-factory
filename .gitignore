# API keys and secrets — never commit real values
.env
.env.*
.env.local
!.env.example
!.env.*.example
frontend/.env
frontend/.env.*
frontend/.env.local
!frontend/.env.example
!frontend/.env.*.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
.venv-df/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Large video/audio files
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3
*.aac

# Local / API project data — never publish (fixtures or user runs)
projects/project-*/
projects/project_*/

# Generated project outputs (belt-and-suspenders if a path is force-added)
projects/*/raw_clips/
projects/*/merged/
projects/*/transcripts/
projects/*/broll/
projects/*/final/
projects/*/subtitles/
projects/*/cover/
projects/.usage/
projects/.users/

# Scrapes / local agent artifacts
.firecrawl/

# Raw script/plan intermediates (keep if you want version history)
# projects/*/raw_script.md
# projects/*/final_script.json
# projects/*/editing_plan.json
# projects/*/filler_segments.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Frontend
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# Root npm (concurrently)
node_modules/
